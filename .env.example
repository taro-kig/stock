# Easier: enter keys on the web UI's settings screen (tab 7) or with `stockai settings set NAME`;
# they are stored in <dataDir>/settings.sqlite and need no .env at all.
#
# .env still works: cp .env.example .env && chmod 600 .env
# Precedence: variables exported in the shell > settings screen > .env.
# Never commit .env and never paste keys into chats or issues.

# ── LLM ───────────────────────────────────────────────
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# ── Prices (Japan): J-Quants dashboard → API Keys ─────
# JQUANTS_API_KEY=

# ── US market data ────────────────────────────────────
# TWELVEDATA_API_KEY=
# SEC_USER_AGENT=stockai you@example.com

# ── Webull Japan OpenAPI (docs/webull.md) ─────────────
# WEBULL_APP_KEY=
# WEBULL_APP_SECRET=

# ── Web UI: only needed when listening on a non-local address ──
# STOCKAI_WEB_TOKEN=

# STOCKAI_LIVE_TRADING is intentionally NOT read from this file (real-money switch).
