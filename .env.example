# Copy to .env (git-ignored) and fill in:   cp .env.example .env && chmod 600 .env
# The CLI and the web server load it automatically. Variables already set in the shell win.
# Never commit .env and never paste keys into chats or issues.

# ── LLM ───────────────────────────────────────────────
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# ── Webull Japan OpenAPI (docs/webull.md) ─────────────
# WEBULL_APP_KEY=
# WEBULL_APP_SECRET=

# ── Web UI: only needed when listening on a non-local address ──
# STOCKAI_WEB_TOKEN=

# STOCKAI_LIVE_TRADING is intentionally NOT read from this file (real-money switch).
