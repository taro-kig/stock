# ── dependencies / build output ─────────────────────────────
node_modules/
dist/
apps/web/dist/
coverage/
*.tsbuildinfo
.vite/

# ── local data: runs, prices, paper accounts, API keys (settings.sqlite) ──
/data/
*.sqlite
*.sqlite-*
*.db
*.db-*

# ── personal config (the *.example.yaml files stay tracked) ──
config/*.yaml
config/*.yml
!config/*.example.yaml

# ── secrets and credentials ─────────────────────────────────
.env
.env.*
!.env.example
deploy/ibkr/.env
deploy/ibkr/secrets/
secrets/
*.pem
*.key
*.p12
*.pfx
*-token.json
*.token
credentials*.json

# ── backups written by the node editor / YAML upload ────────
*.bak

# ── logs (servers may echo request details) ─────────────────
*.log
npm-debug.log*

# ── OS / editor clutter ─────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
